---
import { AUTHOR, SOCIAL } from '../consts';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<p class="dim">
			© {year} {AUTHOR} · 站内同人作品均为非商业性质的二次创作，版权归原作品版权方所有
		</p>
		<div class="links">
			{SOCIAL.map((s) => <a href={s.href} rel="me">{s.label}</a>)}
			<a href={url('/rss.xml')}>RSS</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		background: var(--bg-soft);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 1.75rem 1.25rem;
	}
	p {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1rem;
		font-size: 0.875rem;
	}
</style>
