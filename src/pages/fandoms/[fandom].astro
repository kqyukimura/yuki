---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getWorksWithStats, getFandomCounts, formatWords, groupByYear } from '../../lib/works';

export async function getStaticPaths() {
	const [fandoms, works] = await Promise.all([getFandomCounts(), getWorksWithStats()]);
	return fandoms.map(({ fandom }) => ({
		params: { fandom },
		props: {
			fandom,
			works: works.filter((w) => w.data.fandom.includes(fandom)),
		},
	}));
}

const { fandom, works } = Astro.props;
const years = groupByYear(works);
const totalWords = works.reduce((s, w) => s + w.stats.wordCount, 0);
---

<Base title={fandom} description={`${fandom} 圈子下的 ${works.length} 篇同人作品`}>
	<header class="page-head">
		<p class="kicker">圈子</p>
		<h1>{fandom}</h1>
		<p class="dim">{works.length} 篇 · {formatWords(totalWords)}</p>
	</header>

	{
		years.map((g) => (
			<section class="year-group">
				<div class="year">{g.year}</div>
				<ul class="stack">
					{g.items.map((work) => (
						<WorkCard work={work} />
					))}
				</ul>
			</section>
		))
	}
</Base>

<style>
	.page-head {
		padding-bottom: 2.5rem;
	}
	.kicker {
		margin: 0 0 0.2rem;
		font-size: 0.76rem;
		letter-spacing: 0.2em;
		color: var(--text-faint);
	}
	.page-head h1 {
		margin-bottom: 0.3rem;
	}
	.page-head .dim {
		margin: 0;
	}
	.year-group + .year-group {
		margin-top: 3rem;
	}
	.year {
		font-family: var(--font-serif);
		font-size: 0.95rem;
		color: var(--text-faint);
		letter-spacing: 0.15em;
		margin-bottom: 0.4rem;
	}
</style>
