---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ChapterNav from '../../../components/ChapterNav.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { url } from '../../../lib/url';
import {
	getWorks,
	getChaptersOf,
	chapterSlugOf,
	countWords,
	formatWords,
} from '../../../lib/works';

export async function getStaticPaths() {
	const works = await getWorks();
	const paths = [];
	for (const work of works) {
		const chapters = await getChaptersOf(work.id);
		chapters.forEach((chapter, i) => {
			paths.push({
				params: { work: work.id, chapter: chapterSlugOf(chapter) },
				props: {
					work,
					chapter,
					prev: chapters[i - 1],
					next: chapters[i + 1],
					total: chapters.length,
				},
			});
		});
	}
	return paths;
}

const { work, chapter, prev, next, total } = Astro.props;
const { Content } = await render(chapter);
---

<Base
	title={`${chapter.data.title} · ${work.data.title}`}
	description={chapter.data.summary ?? work.data.summary}
	type="article"
	reading
>
	<article>
		<header class="head">
			<a class="up" href={url(`/works/${work.id}/`)}>{work.data.title}</a>
			<h1>{chapter.data.title}</h1>
			<p class="meta">
				第 {chapter.data.order} / {total} 章 · {formatWords(countWords(chapter.body))}{' · '}
				<FormattedDate date={chapter.data.pubDate} />
			</p>
		</header>

		{chapter.data.summary && <p class="note">{chapter.data.summary}</p>}

		<div class="prose">
			<Content />
		</div>

		<ChapterNav workId={work.id} prev={prev} next={next} />
	</article>
</Base>

<style>
	.head {
		margin-bottom: 2.5rem;
	}
	.up {
		display: inline-block;
		margin-bottom: 1rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.up::before {
		content: '← ';
	}
	.up:hover {
		color: var(--accent);
	}
	.head h1 {
		margin-bottom: 0.6rem;
	}
	.meta {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	/* 章节前注：左侧细线，不用整块灰底 */
	.note {
		margin: 0 0 2.5rem;
		padding-left: 1.1rem;
		border-left: 2px solid var(--rule);
		font-family: var(--font-serif);
		font-size: 0.95rem;
		line-height: 1.9;
		color: var(--text-muted);
	}
</style>
