---
import { NAV, SITE_TITLE } from '../consts';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const home = url('/');
const isActive = (href: string) => {
	const target = url(href);
	return target === home ? path === home : path.startsWith(target);
};
---

<header>
	<nav>
		<a class="brand" href={home}>{SITE_TITLE}</a>
		{/* 手机端导航移到底栏，这里隐藏 */}
		<div class="links">
			{
				NAV.map((item) => (
					<a href={url(item.href)} class:list={['pill', { active: isActive(item.href) }]}>
						{item.label}
					</a>
				))
			}
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--bg) 80%, transparent);
		backdrop-filter: blur(12px);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0.9rem 1.25rem;
	}
	.brand {
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text);
		text-decoration: none;
		margin-right: auto;
	}
	.links {
		display: flex;
		gap: 0.35rem;
	}
	/* Material 3 的 pill 导航 */
	.pill {
		padding: 0.4em 1em;
		border-radius: var(--r-pill);
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.pill:hover {
		background: var(--surface-2);
		color: var(--text);
	}
	.pill.active {
		background: var(--accent-soft);
		color: var(--accent);
		font-weight: 500;
	}
	@media (max-width: 720px) {
		.links {
			display: none;
		}
		nav {
			padding: 0.75rem 1rem;
		}
	}
</style>
