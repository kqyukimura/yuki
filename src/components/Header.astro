---
import { NAV, SITE_TITLE } from '../consts';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

// Astro.url.pathname 带 base 前缀，所以要拿加过前缀的路径来比对
const path = Astro.url.pathname;
const home = url('/');
const isActive = (href: string) => {
	const target = url(href);
	return target === home ? path === home : path.startsWith(target);
};
---

<header>
	<nav>
		<a class="brand" href={home}>{SITE_TITLE}</a>
		<div class="links">
			{
				NAV.map((item) => (
					<a href={url(item.href)} class:list={[{ active: isActive(item.href) }]}>
						{item.label}
					</a>
				))
			}
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1rem;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0.75rem 1.25rem;
	}
	.brand {
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--text);
		text-decoration: none;
		margin-right: auto;
	}
	.brand:hover {
		color: var(--accent);
	}
	.links {
		display: flex;
		gap: 0.35rem;
	}
	.links a {
		padding: 0.3em 0.7em;
		border-radius: 8px;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.925rem;
	}
	.links a:hover {
		color: var(--text);
		background: var(--bg-soft);
	}
	.links a.active {
		color: var(--accent);
		background: var(--accent-soft);
	}
	@media (max-width: 720px) {
		nav {
			padding: 0.6rem 1rem;
			gap: 0.5rem;
		}
		.brand {
			font-size: 1rem;
		}
		.links a {
			padding: 0.3em 0.5em;
			font-size: 0.875rem;
		}
	}
</style>
