---
import type { Chapter } from '../lib/works';
import { chapterSlugOf } from '../lib/works';
import { url } from '../lib/url';

interface Props {
	workId: string;
	prev?: Chapter;
	next?: Chapter;
}
const { workId, prev, next } = Astro.props;
---

<nav class="chapter-nav">
	<div class="side">
		{
			prev && (
				<a href={url(`/works/${workId}/${chapterSlugOf(prev)}/`)}>
					<span class="lbl">上一章</span>
					<span class="t">{prev.data.title}</span>
				</a>
			)
		}
	</div>
	<a class="toc" href={url(`/works/${workId}/`)}>目录</a>
	<div class="side right">
		{
			next && (
				<a href={url(`/works/${workId}/${chapterSlugOf(next)}/`)}>
					<span class="lbl">下一章</span>
					<span class="t">{next.data.title}</span>
				</a>
			)
		}
	</div>
</nav>

<style>
	.chapter-nav {
		display: flex;
		align-items: flex-start;
		gap: 1.5rem;
		margin-top: 4rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--rule);
	}
	.side {
		flex: 1;
		min-width: 0;
	}
	.side.right {
		text-align: right;
	}
	.side a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		text-decoration: none;
	}
	.lbl {
		font-size: 0.74rem;
		letter-spacing: 0.1em;
		color: var(--text-faint);
	}
	.t {
		font-family: var(--font-serif);
		font-size: 0.98rem;
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.side a:hover .t {
		color: var(--accent);
	}
	.toc {
		flex: 0 0 auto;
		align-self: center;
		font-size: 0.85rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.toc:hover {
		color: var(--accent);
	}
</style>
