---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { url } from '../../lib/url';
import { getWorksWithStats, getEssays, getTagCounts } from '../../lib/works';

export async function getStaticPaths() {
	const [tags, works, essays] = await Promise.all([
		getTagCounts(),
		getWorksWithStats(),
		getEssays(),
	]);
	return tags.map(({ tag }) => ({
		params: { tag },
		props: {
			tag,
			works: works.filter((w) => w.data.tags.includes(tag)),
			essays: essays.filter((e) => e.data.tags.includes(tag)),
		},
	}));
}

const { tag, works, essays } = Astro.props;
const total = works.length + essays.length;
---

<Base title={tag} description={`标签「${tag}」下的 ${total} 篇内容`}>
	<header class="page-head">
		<p class="kicker">标签</p>
		<h1>{tag}</h1>
		<p class="dim">{total} 篇内容</p>
	</header>

	{
		works.length > 0 && (
			<section>
				<h2>作品</h2>
				<ul class="stack">
					{works.map((work) => (
						<WorkCard work={work} />
					))}
				</ul>
			</section>
		)
	}

	{
		essays.length > 0 && (
			<section>
				<h2>随笔</h2>
				<ul class="stack">
					{essays.map((e) => (
						<li>
							<a class="card" href={url(`/essays/${e.id}/`)}>
								<h3>{e.data.title}</h3>
								<ul class="meta-row">
									<li>
										<FormattedDate date={e.data.pubDate} />
									</li>
								</ul>
								<p>{e.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	.page-head {
		padding-bottom: 2rem;
	}
	.kicker {
		margin: 0 0 0.2rem;
		font-size: 0.76rem;
		letter-spacing: 0.2em;
		color: var(--text-faint);
	}
	.page-head h1 {
		margin-bottom: 0.3rem;
	}
	.page-head .dim {
		margin: 0;
	}
	section h2 {
		margin-top: 2.5rem;
	}
</style>
