---
import { AUTHOR, SOCIAL } from '../consts';
import { url } from '../lib/url';
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<p>
			© {year} {AUTHOR}<br />
			<span class="fine">
				站内同人作品均为非商业性质的二次创作，版权归原作品版权方所有
			</span>
		</p>
		<div class="links">
			{SOCIAL.map((s) => <a class="badge" href={s.href} rel="me">{s.label}</a>)}
			<a class="badge" href={url('/rss.xml')}>RSS</a>
		</div>
	</div>
</footer>

<style>
	.inner {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: center;
		justify-content: space-between;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 2rem 1.25rem 3rem;
	}
	p {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.8;
	}
	.fine {
		color: var(--text-faint);
		font-size: 0.78rem;
	}
	.links {
		display: flex;
		gap: 0.5rem;
	}
</style>
