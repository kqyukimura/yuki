---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

// 内容来自 src/content/pages/about.md，可在后台「页面 → 关于」里编辑
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 src/content/pages/about.md');
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description} reading>
	<h1>{entry.data.title}</h1>
	<div class="prose">
		<Content />
	</div>
</Base>
