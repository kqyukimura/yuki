---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_QUOTE } from '../consts';
import { url } from '../lib/url';
import { getWorksWithStats, getEssays, getTagCounts } from '../lib/works';

const all = await getWorksWithStats();
// 置顶的排前面，其余保持时间倒序
const recent = [...all]
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
	.slice(0, 5);
const essays = (await getEssays()).slice(0, 4);
const tags = (await getTagCounts()).slice(0, 24);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header class="hero">
		<h1 class="grad-text">{SITE_QUOTE || SITE_TITLE}</h1>
		<p>{SITE_DESCRIPTION}</p>
	</header>

	<section>
		<div class="sec-head">
			<h2>作品</h2>
			{
				all.length > recent.length && (
					<a class="badge" href={url('/works/')}>
						全部 {all.length} 篇
					</a>
				)
			}
		</div>

		{
			recent.length === 0 ? (
				<p class="dim empty">
					还没有作品。到 <a href={url('/admin/')}>后台</a> 建第一篇。
				</p>
			) : (
				<ul class="stack">
					{recent.map((work) => (
						<WorkCard work={work} />
					))}
				</ul>
			)
		}
	</section>

	{
		essays.length > 0 && (
			<section>
				<div class="sec-head">
					<h2>随笔</h2>
					<a class="badge" href={url('/essays/')}>
						全部
					</a>
				</div>
				<ul class="stack">
					{essays.map((e) => (
						<li>
							<a class="card compact" href={url(`/essays/${e.id}/`)}>
								<span class="ct">{e.data.title}</span>
								<span class="cd">
									<FormattedDate date={e.data.pubDate} />
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		tags.length > 0 && (
			<section>
				<h2>标签</h2>
				<ul class="meta-row">
					{tags.map((t) => (
						<li>
							<a class="badge" href={url(`/tags/${encodeURIComponent(t.tag)}/`)}>
								{t.tag}
								<span class="n">{t.count}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	.hero {
		padding: 2.5rem 0 3rem;
	}
	.hero h1 {
		font-size: clamp(2.2rem, 7vw, 3.2rem);
		line-height: 1.25;
		margin: 0 0 0.6rem;
		/* 渐变文字需要一点内边距，否则右侧字形会被裁掉 */
		padding-right: 0.1em;
	}
	.hero p {
		margin: 0;
		color: var(--text-muted);
		font-size: 1.02rem;
	}

	section {
		margin-bottom: 3.5rem;
	}
	.sec-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.sec-head h2 {
		margin: 0;
		font-size: 1.15rem;
	}
	.empty {
		padding-top: 0.5rem;
	}

	/* 随笔用扁一点的卡片 */
	.compact {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 1rem 1.4rem;
	}
	.ct {
		font-size: 1rem;
		color: var(--text);
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.cd {
		flex: 0 0 auto;
		font-size: 0.78rem;
		color: var(--text-faint);
	}
	.n {
		margin-left: 0.35em;
		font-size: 0.72rem;
		color: var(--text-faint);
	}
</style>
