---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import WorkMeta from '../../../components/WorkMeta.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { url } from '../../../lib/url';
import {
	getWorks,
	getChaptersOf,
	getStats,
	chapterSlugOf,
	countWords,
	formatWords,
} from '../../../lib/works';

export async function getStaticPaths() {
	const works = await getWorks();
	return Promise.all(
		works.map(async (work) => ({
			params: { work: work.id },
			props: {
				work,
				chapters: await getChaptersOf(work.id),
				stats: await getStats(work),
			},
		})),
	);
}

const { work, chapters, stats } = Astro.props;
const { Content } = await render(work);
const { title, summary, warnings, tags, pubDate, updatedDate, heroImage } = work.data;
---

<Base title={title} description={summary} image={heroImage} type="article" reading={stats.isOneshot}>
	<article>
		<header class="head">
			<h1>{title}</h1>
			<WorkMeta work={work} stats={stats} />
			<p class="dates">
				<FormattedDate date={pubDate} />
				{updatedDate && <> · 最后更新 <FormattedDate date={updatedDate} /></>}
			</p>
		</header>

		{heroImage && <Image class="hero" src={heroImage} alt="" width={900} />}

		{
			warnings.length > 0 && (
				<aside class="warnings">
					<strong>阅读预警</strong>
					<span>{warnings.join(' · ')}</span>
				</aside>
			)
		}

		<p class="summary">{summary}</p>

		<div class="prose">
			<Content />
		</div>

		{
			!stats.isOneshot && (
				<section class="toc">
					<h2>目录</h2>
					<ol class="stack">
						{chapters.map((c) => (
							<li>
								<a class="card chapter" href={url(`/works/${work.id}/${chapterSlugOf(c)}/`)}>
									<span class="num">{String(c.data.order).padStart(2, '0')}</span>
									<span class="ct">{c.data.title}</span>
									<span class="wc">{formatWords(countWords(c.body))}</span>
								</a>
							</li>
						))}
					</ol>
				</section>
			)
		}

		{
			tags.length > 0 && (
				<footer class="tags">
					<ul class="meta-row">
						{tags.map((t) => (
							<li>
								<a class="badge" href={url(`/tags/${encodeURIComponent(t)}/`)}>
									{t}
								</a>
							</li>
						))}
					</ul>
				</footer>
			)
		}
	</article>
</Base>

<style>
	.head {
		margin-bottom: 1.75rem;
	}
	.head h1 {
		margin-bottom: 0.9rem;
	}
	.dates {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--r-xl);
		margin-bottom: 1.75rem;
	}
	.warnings {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.7rem;
		padding: 0.9rem 1.2rem;
		margin-bottom: 1.5rem;
		border-radius: var(--r-md);
		background: var(--accent-soft);
		font-size: 0.88rem;
	}
	.warnings strong {
		color: var(--accent);
		font-weight: 600;
	}
	.warnings span {
		color: var(--text-muted);
	}
	.summary {
		margin: 0 0 2rem;
		padding: 1.1rem 1.3rem;
		border-radius: var(--r-lg);
		background: var(--surface-2);
		font-size: 0.96rem;
		line-height: 1.8;
		color: var(--text-muted);
	}
	.toc {
		margin-top: 3rem;
	}
	.toc h2 {
		margin-top: 0;
		font-size: 1.15rem;
	}
	.chapter {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 1.4rem;
	}
	.num {
		flex: 0 0 auto;
		font-size: 0.85rem;
		color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}
	.ct {
		flex: 1;
		min-width: 0;
		font-size: 1rem;
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.wc {
		flex: 0 0 auto;
		font-size: 0.76rem;
		color: var(--text-faint);
	}
	.tags {
		margin-top: 3rem;
	}
	.tags .meta-row {
		margin: 0;
	}
</style>
