---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import WorkCard from '../../components/WorkCard.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getWorksWithStats, getEssays, getTagCounts } from '../../lib/works';

export async function getStaticPaths() {
	const [tags, works, essays] = await Promise.all([
		getTagCounts(),
		getWorksWithStats(),
		getEssays(),
	]);
	return tags.map(({ tag }) => ({
		params: { tag },
		props: {
			tag,
			works: works.filter((w) => w.data.tags.includes(tag)),
			essays: essays.filter((e) => e.data.tags.includes(tag)),
		},
	}));
}

const { tag, works, essays } = Astro.props;
const total = works.length + essays.length;
---

<Base title={`#${tag}`} description={`标签「${tag}」下的 ${total} 篇内容`}>
	<h1>#{tag}</h1>
	<p class="dim intro">{total} 篇内容</p>

	{
		works.length > 0 && (
			<section>
				<h2>作品</h2>
				<ul class="stack">
					{works.map((work) => (
						<WorkCard work={work} />
					))}
				</ul>
			</section>
		)
	}

	{
		essays.length > 0 && (
			<section>
				<h2>随笔</h2>
				<ul class="stack">
					{essays.map((e) => (
						<li>
							<a class="card" href={url(`/essays/${e.id}/`)}>
								<h3>{e.data.title}</h3>
								<p class="dim date">
									<FormattedDate date={e.data.pubDate} />
								</p>
								<p>{e.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	.intro {
		margin-top: -0.5rem;
		margin-bottom: 2rem;
	}
	.date {
		margin: 0;
		font-size: 0.8rem;
	}
</style>
