---
import { NAV, SITE_TITLE } from '../consts';
import { url } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';

// Astro.url.pathname 带 base 前缀，所以要拿加过前缀的路径来比对
const path = Astro.url.pathname;
const home = url('/');
const isActive = (href: string) => {
	const target = url(href);
	return target === home ? path === home : path.startsWith(target);
};
---

<header>
	<nav>
		<a class="brand" href={home}>{SITE_TITLE}</a>
		<div class="links">
			{
				NAV.map((item) => (
					<a href={url(item.href)} class:list={[{ active: isActive(item.href) }]}>
						{item.label}
					</a>
				))
			}
		</div>
		<ThemeToggle />
	</nav>
</header>

<style>
	header {
		border-bottom: 1px solid var(--rule);
		background: var(--bg);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 1.1rem 1.5rem;
	}
	.brand {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.1rem;
		letter-spacing: 0.04em;
		color: var(--text);
		text-decoration: none;
		margin-right: auto;
	}
	.brand:hover {
		color: var(--accent);
	}
	.links {
		display: flex;
		gap: 1.4rem;
	}
	.links a {
		position: relative;
		padding: 0.2em 0;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.9rem;
	}
	.links a:hover {
		color: var(--text);
	}
	/* 当前栏目用一条细下划线标记，比色块安静 */
	.links a.active {
		color: var(--text);
	}
	.links a.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.35em;
		height: 1px;
		background: var(--accent);
	}
	@media (max-width: 720px) {
		nav {
			padding: 0.9rem 1.25rem;
			gap: 1rem;
		}
		.links {
			gap: 1rem;
		}
		.links a {
			font-size: 0.85rem;
		}
	}
</style>
