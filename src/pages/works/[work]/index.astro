---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import WorkMeta from '../../../components/WorkMeta.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { url } from '../../../lib/url';
import {
	getWorks,
	getChaptersOf,
	getStats,
	chapterSlugOf,
	countWords,
	formatWords,
} from '../../../lib/works';

export async function getStaticPaths() {
	const works = await getWorks();
	return Promise.all(
		works.map(async (work) => ({
			params: { work: work.id },
			props: {
				work,
				chapters: await getChaptersOf(work.id),
				stats: await getStats(work),
			},
		})),
	);
}

const { work, chapters, stats } = Astro.props;
const { Content } = await render(work);
const { title, summary, warnings, tags, pubDate, updatedDate, heroImage } = work.data;
---

<Base title={title} description={summary} image={heroImage} type="article" reading={stats.isOneshot}>
	<article>
		<header class="head">
			<h1>{title}</h1>
			<WorkMeta work={work} stats={stats} />
			<p class="dates">
				<FormattedDate date={pubDate} />
				{updatedDate && <> · 最后更新 <FormattedDate date={updatedDate} /></>}
			</p>
		</header>

		{heroImage && <Image class="hero" src={heroImage} alt="" width={900} />}

		{
			warnings.length > 0 && (
				<aside class="warnings">
					<strong>阅读预警</strong>
					<span>{warnings.join(' · ')}</span>
				</aside>
			)
		}

		<p class="summary">{summary}</p>

		{/* 短篇：index.md 的正文就是作品本身。长篇：这里是前言/说明 */}
		<div class="prose">
			<Content />
		</div>

		{
			!stats.isOneshot && (
				<section class="toc">
					<h2>目录</h2>
					<ol class="chapters">
						{chapters.map((c) => (
							<li>
								<a href={url(`/works/${work.id}/${chapterSlugOf(c)}/`)}>
									<span class="num">{String(c.data.order).padStart(2, '0')}</span>
									<span class="ct">{c.data.title}</span>
									<span class="wc">{formatWords(countWords(c.body))}</span>
								</a>
							</li>
						))}
					</ol>
				</section>
			)
		}

		{
			tags.length > 0 && (
				<footer class="tags">
					{tags.map((t) => (
						<a href={url(`/tags/${encodeURIComponent(t)}/`)}>{t}</a>
					))}
				</footer>
			)
		}
	</article>
</Base>

<style>
	.head {
		margin-bottom: 2.5rem;
	}
	.head h1 {
		margin-bottom: 0.9rem;
	}
	.dates {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 2.5rem;
	}
	/* 预警用左侧色条，比整框边框安静但依然醒目 */
	.warnings {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		padding: 0.8rem 0 0.8rem 1.1rem;
		margin-bottom: 2rem;
		border-left: 2px solid var(--accent);
		background: var(--accent-soft);
		font-size: 0.88rem;
	}
	.warnings strong {
		color: var(--accent);
		font-weight: 600;
	}
	.warnings span {
		color: var(--text-muted);
	}
	.summary {
		margin: 0 0 2.5rem;
		font-family: var(--font-serif);
		font-size: 1.02rem;
		line-height: 1.95;
		color: var(--text-muted);
	}

	/* ── 目录 ───────────────────────────────────────────── */
	.toc {
		margin-top: 4rem;
	}
	.toc h2 {
		margin-top: 0;
	}
	.chapters {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}
	.chapters a {
		display: flex;
		align-items: baseline;
		gap: 1.1rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--rule);
		text-decoration: none;
		transition: padding-left 0.18s ease;
	}
	.chapters a:hover {
		padding-left: 0.5rem;
	}
	.num {
		flex: 0 0 auto;
		font-family: var(--font-serif);
		font-size: 0.85rem;
		color: var(--text-faint);
		font-variant-numeric: tabular-nums;
	}
	.ct {
		flex: 1;
		min-width: 0;
		font-family: var(--font-serif);
		font-size: 1.02rem;
		color: var(--text);
	}
	.chapters a:hover .ct {
		color: var(--accent);
	}
	.wc {
		flex: 0 0 auto;
		font-size: 0.76rem;
		color: var(--text-faint);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.3rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}
	.tags a {
		font-size: 0.88rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.tags a:hover {
		color: var(--accent);
	}
</style>
