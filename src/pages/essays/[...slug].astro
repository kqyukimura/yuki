---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { url } from '../../lib/url';
import { getEssays } from '../../lib/works';

export async function getStaticPaths() {
	const essays = await getEssays();
	return essays.map((essay) => ({ params: { slug: essay.id }, props: essay }));
}

const essay = Astro.props;
const { Content } = await render(essay);
const { title, description, pubDate, updatedDate, heroImage, tags } = essay.data;
---

<Base title={title} description={description} image={heroImage} type="article" reading>
	<article>
		<header class="head">
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				{updatedDate && <> · 更新于 <FormattedDate date={updatedDate} /></>}
			</p>
		</header>

		{heroImage && <Image class="hero" src={heroImage} alt="" width={860} />}

		<div class="prose">
			<Content />
		</div>

		{
			tags.length > 0 && (
				<footer class="tags">
					{tags.map((t) => (
						<a href={url(`/tags/${encodeURIComponent(t)}/`)}>{t}</a>
					))}
				</footer>
			)
		}
	</article>
</Base>

<style>
	.head {
		margin-bottom: 2.5rem;
	}
	.head h1 {
		margin-bottom: 0.6rem;
	}
	.meta {
		margin: 0;
		font-size: 0.8rem;
		color: var(--text-faint);
	}
	.hero {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 2.5rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.3rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}
	.tags a {
		font-size: 0.88rem;
		color: var(--text-muted);
		text-decoration: none;
	}
	.tags a:hover {
		color: var(--accent);
	}
</style>
