---
import type { Work, WorkStats } from '../lib/works';
import { url } from '../lib/url';
import WorkMeta from './WorkMeta.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
	work: Work & { stats: WorkStats };
}
const { work } = Astro.props;
---

<li>
	<a class="card" href={url(`/works/${work.id}/`)}>
		<h3>{work.data.title}</h3>
		{/* 卡片整体就是链接，里面的元信息不能再套 <a> */}
		<WorkMeta work={work} stats={work.stats} linked={false} />
		<p>{work.data.summary}</p>
		<p class="dim date"><FormattedDate date={work.data.pubDate} /></p>
	</a>
</li>

<style>
	.date {
		margin-top: 0.75rem;
		font-size: 0.8rem;
	}
</style>
