---
import type { Chapter } from '../lib/works';
import { chapterSlugOf } from '../lib/works';
import { url } from '../lib/url';

interface Props {
	workId: string;
	prev?: Chapter;
	next?: Chapter;
}
const { workId, prev, next } = Astro.props;
---

<nav class="chapter-nav">
	<div class="side">
		{
			prev && (
				<a class="card" href={url(`/works/${workId}/${chapterSlugOf(prev)}/`)}>
					<span class="lbl">← 上一章</span>
					<span class="t">{prev.data.title}</span>
				</a>
			)
		}
	</div>
	<div class="side right">
		{
			next && (
				<a class="card" href={url(`/works/${workId}/${chapterSlugOf(next)}/`)}>
					<span class="lbl">下一章 →</span>
					<span class="t">{next.data.title}</span>
				</a>
			)
		}
	</div>
</nav>

<a class="toc badge" href={url(`/works/${workId}/`)}>返回目录</a>

<style>
	.chapter-nav {
		display: flex;
		gap: 0.75rem;
		margin-top: 3rem;
	}
	.side {
		flex: 1;
		min-width: 0;
		display: flex;
	}
	.side.right {
		justify-content: flex-end;
	}
	.side .card {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem 1.2rem;
	}
	.side.right .card {
		text-align: right;
	}
	.lbl {
		font-size: 0.74rem;
		color: var(--text-faint);
	}
	.t {
		font-size: 0.95rem;
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.toc {
		display: block;
		width: fit-content;
		margin: 1rem auto 0;
	}
	@media (max-width: 560px) {
		.chapter-nav {
			flex-direction: column;
		}
		.side.right .card {
			text-align: left;
		}
	}
</style>
