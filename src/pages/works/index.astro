---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { url } from '../../lib/url';
import { getWorksWithStats, getFandomCounts, formatWords, groupByYear } from '../../lib/works';

const works = await getWorksWithStats();
const fandoms = await getFandomCounts();
const years = groupByYear(works);
const totalWords = works.reduce((s, w) => s + w.stats.wordCount, 0);
---

<Base title="作品" description="全部同人作品归档">
	<header class="page-head">
		<h1>作品</h1>
		<p class="dim">共 {works.length} 篇 · {formatWords(totalWords)}</p>
		{
			fandoms.length > 1 && (
				<ul class="meta-row filters">
					{fandoms.map((f) => (
						<li>
							<a class="badge" href={url(`/fandoms/${encodeURIComponent(f.fandom)}/`)}>
								{f.fandom}
								<span class="n">{f.count}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</header>

	{
		works.length === 0 ? (
			<p class="dim">
				还没有作品。到 <a href={url('/admin/')}>后台</a> 建第一篇。
			</p>
		) : (
			years.map((g) => (
				<section class="year-group">
					<h2 class="year">{g.year}</h2>
					<ul class="stack">
						{g.items.map((work) => (
							<WorkCard work={work} />
						))}
					</ul>
				</section>
			))
		)
	}
</Base>

<style>
	.page-head {
		padding: 1rem 0 2rem;
	}
	.page-head h1 {
		margin-bottom: 0.25rem;
	}
	.page-head .dim {
		margin: 0;
	}
	.filters {
		margin-top: 1.1rem;
		margin-bottom: 0;
	}
	.n {
		margin-left: 0.35em;
		font-size: 0.72rem;
		color: var(--text-faint);
	}
	.year-group + .year-group {
		margin-top: 2.5rem;
	}
	.year {
		margin: 0 0 0.9rem;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--text-faint);
	}
</style>
