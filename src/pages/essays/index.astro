---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { url } from '../../lib/url';
import { getEssays, groupByYear } from '../../lib/works';

const essays = await getEssays();
const years = groupByYear(essays);
---

<Base title="随笔" description="杂谈、创作手记与其他文字">
	<header class="page-head">
		<h1>随笔</h1>
		<p class="dim">共 {essays.length} 篇</p>
	</header>

	{
		essays.length === 0 ? (
			<p class="dim">
				还没有随笔。到 <a href={url('/admin/')}>后台</a> 写一篇。
			</p>
		) : (
			years.map((g) => (
				<section class="year-group">
					<h2 class="year">{g.year}</h2>
					<ul class="stack">
						{g.items.map((e) => (
							<li>
								<a class="card" href={url(`/essays/${e.id}/`)}>
									<h3>{e.data.title}</h3>
									<ul class="meta-row">
										<li>
											<span class="badge is-plain">
												<FormattedDate date={e.data.pubDate} />
											</span>
										</li>
										{e.data.tags.slice(0, 3).map((t) => (
											<li>
												<span class="badge">{t}</span>
											</li>
										))}
									</ul>
									<p>{e.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		)
	}
</Base>

<style>
	.page-head {
		padding: 1rem 0 2rem;
	}
	.page-head h1 {
		margin-bottom: 0.25rem;
	}
	.page-head .dim {
		margin: 0;
	}
	.year-group + .year-group {
		margin-top: 2.5rem;
	}
	.year {
		margin: 0 0 0.9rem;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--text-faint);
	}
</style>
